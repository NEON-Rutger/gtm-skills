# Fires when skill content lands on main, telling the backend to re-sync
# the repo into the LibrarySkill table. The backend does the actual upsert
# (idempotent, by slug, content columns only). This just pings it.
#
# Setup: add a repo secret SYNC_WEBHOOK_URL (the backend sync endpoint) and
# SYNC_WEBHOOK_TOKEN (a shared secret the endpoint checks).

name: sync-to-library

on:
  push:
    branches: [main]
    paths:
      - 'skills/**'
  workflow_dispatch: {} # manual re-sync / backfill

jobs:
  notify-backend:
    runs-on: ubuntu-latest
    steps:
      - name: Trigger LibrarySkill sync
        run: |
          curl -fsS -X POST "$SYNC_WEBHOOK_URL" \
            -H "Authorization: Bearer $SYNC_WEBHOOK_TOKEN" \
            -H "Content-Type: application/json" \
            -d '{"ref": "${{ github.sha }}", "repo": "${{ github.repository }}"}'
        env:
          SYNC_WEBHOOK_URL: ${{ secrets.SYNC_WEBHOOK_URL }}
          SYNC_WEBHOOK_TOKEN: ${{ secrets.SYNC_WEBHOOK_TOKEN }}
</content>
